@@ -82,13 +82,13 @@ _start:
 #ifndef RISCV_QEMU
 	// invalidate all memory for BTB,BHT,DCACHE,ICACHE
 	li x3, 0x30013
-	csrs mcor, x3
+	csrs 0x7c2, x3
 	// enable ICACHE,DCACHE,BHT,BTB,RAS,WA
 	li x3, 0x7f
-	csrs mhcr, x3
+	csrs 0x7c1, x3
 	// enable data_cache_prefetch, amr
 	li x3, 0x610c
-	csrs mhint, x3 #mhint
+	csrs 0x7c5, x3 #mhint
 #endif
 	# enable fp
 	li x3, 0x1 << 13
