CompileFlags:
  CompilationDatabase: build/clangd

Diagnostics:
  ClangTidy:
    Add: [clang-analyzer-*, bugprone-*, performance-*]
    Remove: [
      bugprone-easily-swappable-parameters,
      bugprone-reserved-identifier,
      performance-no-int-to-ptr
    ]

---
# The host-side tests and tools are compiled by native GCC for Linux, so the
# firmware database cannot describe them: its RISC-V newlib sysroot has no
# POSIX headers, and sys/mman.h and ucontext.h appear to be missing. Point
# those paths at the host database instead. The firmware build exports it too;
# refresh it alone with `cmake --build build --target clangd`.
If:
  PathMatch: '(.*/)?(driver/tests|sg200x-ll-driver/tests|tools|libxr/system/linux|libxr/driver/linux)/.*'
CompileFlags:
  CompilationDatabase: build/clangd-host

---
# mmfprobe.c provides its own __sync_* helpers for the board's musl toolchain.
# Clang always treats those names as builtins and rejects the definitions, while
# the GCC that compiles this file accepts them, so the diagnostic cannot be
# cleared with a flag.
If:
  PathMatch: '(.*/)?tools/sg2002-camera-bridge/mmfprobe\.c'
Diagnostics:
  Suppress: [builtin_redeclare]
